{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      { "patterns": [{ "group": ["@ui-sdk/**"], "message": "Screens use the wrappers in src/ui/; only src/ui/ imports the UI SDK." }] }
    ],
    "react/forbid-elements": [
      "error",
      { "forbid": [{ "element": "button", "message": "Use Button from src/ui/Button.tsx: a ui-sdk agent can't see or press a plain <button>." }] }
    ]
  },
  "overrides": [
    {
      "files": ["src/ui/**"],
      "rules": { "no-restricted-imports": "off", "react/forbid-elements": "off" }
    }
  ]
}
